# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/

# Packaging
build/
dist/
*.egg-info/
.eggs/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Run artifacts. These are experiment outputs, not source: the scan dump,
# checkpoints, and evaluation JSON are large, machine-specific, and
# regenerated by pipeline.sh. `MULTIHARNESS_OUT` can point elsewhere.
outputs/

# Model weights and adapters, wherever a run decides to put them
*.safetensors
*.bin
*.pt
*.ckpt
*.gguf

# HuggingFace / dataset caches
.cache/
hf-cache/

# Editors and OS cruft
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local overrides of the launcher's environment
.env
.env.local
