# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/

# Packaging
build/
dist/
*.egg-info/
.eggs/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Run artifacts. These are experiment outputs, not source: the scan dump,
# checkpoints, and evaluation JSON are large, machine-specific, and
# regenerated by pipeline.sh. `MULTIHARNESS_OUT` can point elsewhere.
#
# `outputs_*` covers a redirected run that lands *beside* `outputs/` — which is
# how the `--score rollout` harness arm is written without overwriting the
# replayed one. Without this the run's generated `check.py` files show up as
# untracked source, and ruff (which skips gitignored paths) starts linting them.
outputs/
outputs_*/

# Model weights and adapters, wherever a run decides to put them
*.safetensors
*.bin
*.pt
*.ckpt
*.gguf

# HuggingFace / dataset caches
.cache/
hf-cache/

# Editors and OS cruft
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local overrides of the launcher's environment
.env
.env.local
